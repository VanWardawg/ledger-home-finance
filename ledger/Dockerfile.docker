# Ledger, packaged to run on the NAS.
# Stage 1 builds the web pages; stage 2 is the small image that actually runs.
# The base image is pinned to one exact published build; move it on deliberately.
FROM node:24-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.ts tsconfig.json ./
COPY public ./public
COPY src ./src
RUN npm run build

FROM node:24-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4317 LEDGER_DATA_DIR=/data
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY server ./server
COPY --from=build /app/dist ./dist
# The database lives in /data, which compose.yaml maps to a folder on the NAS. The folder is made here and
# given to the user Ledger runs as, so a volume Docker makes by itself can be written to as well.
RUN mkdir -p /data && chown node:node /data
VOLUME /data
EXPOSE 4317
USER node
CMD ["node", "server/index.js"]
